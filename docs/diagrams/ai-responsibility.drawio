          <mxGeometry x="740" y="50" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="按 Checkpoint 推进 5 阶段&#10;失败可恢复，不重跑已完成阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-app">
          <mxGeometry x="1020" y="50" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="lane-ai" value="AI 模型  ·  仅此两处调用 generateStructured" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ai1" value="任务 1  extract-job-draft/v1&#10;&#10;输入：不可信 JD 原文&#10;输出：title / company / location /&#10;薪资区间 / 职责 / 要求 / 福利&#10;&#10;禁止：推测发薪月数、补造缺失字段" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="lane-ai">
          <mxGeometry x="30" y="50" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ai2" value="任务 2  screen-opportunity/v1&#10;&#10;输入：脱敏简历 + JD&#10;输出：候选 Claim&#10;dimension / polarity / 双侧短引用&#10;&#10;禁止：硬约束、薪资结论、最终推荐" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="lane-ai">
          <mxGeometry x="740" y="50" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ai-note" value="LocalDemoModel 或 DeepSeek Adapter&#10;业务层只依赖 ModelGateway，不感知 SDK" style="text;html=1;align=left;verticalAlign=middle;fontColor=#5a3d6b;fontSize=11;" vertex="1" parent="lane-ai">
          <mxGeometry x="1080" y="80" width="360" height="50" as="geometry" />
        </mxCell>

