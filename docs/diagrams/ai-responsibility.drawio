<mxfile host="drawio" version="26.0.0">
  <diagram id="ai-responsibility" name="AI 职责边界">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="核心 AI 职责：模型只做两件事，其余全部是确定性规则" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="30" as="geometry" />
        </mxCell>

        <mxCell id="lane-user" value="用户" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="粘贴 JD 文本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-user">
