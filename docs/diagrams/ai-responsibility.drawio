          <mxGeometry x="40" y="220" width="1480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="排队 extract-job-draft&#10;冻结 modelConfig" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-app">
          <mxGeometry x="30" y="50" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="合并字段到 JobDraft&#10;记录来源 extracted / default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-app">
          <mxGeometry x="340" y="50" width="200" height="70" as="geometry" />
        </mxCell>
