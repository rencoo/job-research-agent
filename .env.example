# Optional. Defaults to <repository>/.data.
JRA_DATA_DIR=

# Local HTTP server defaults.
JRA_HOST=127.0.0.1
JRA_PORT=4310

# Model runtime. Keep "local" for the offline deterministic demo.
JRA_MODEL_PROVIDER=local

# Required only when JRA_MODEL_PROVIDER=deepseek. Never commit a real key.
DEEPSEEK_API_KEY=

# Optional DeepSeek model override.
JRA_DEEPSEEK_MODEL=deepseek-v4-flash

# Cost guard used only by `pnpm test:deepseek-live`; leave disabled normally.
JRA_RUN_LIVE_EVAL=0
